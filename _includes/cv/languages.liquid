{% comment %}
  Unified languages entry renderer for both formats
  - RenderCV uses: name, summary
  - JSONResume uses: language, fluency

  Laid out as a two-column table of equal width. A new row opens every second
  entry, so an odd count leaves the last cell half-width rather than stretching.
{% endcomment %}

{% comment %}
  Wrapped in the same list-group markup the other cv/*.liquid sections use, so
  the table picks up .list-group-item's padding and lines up with them.
{% endcomment %}
<ul class="card-text font-weight-light list-group list-group-flush">
  <li class="list-group-item">
    <table class="languages-table">
      <tbody>
        {% for entry in entries %}
          {% assign column = forloop.index0 | modulo: 2 %}
          {% if column == 0 %}<tr>{% endif %}

          <td>
            {% capture lang_name %}
          {% if entry.name %}{{ entry.name }}{% elsif entry.language %}{{ entry.language }}{% endif %}
        {% endcapture %}
            {% capture fluency %}
          {% if entry.summary %}{{ entry.summary }}{% elsif entry.fluency %}{{ entry.fluency }}{% endif %}
        {% endcapture %}

            {% if entry.icon %}
              <i class="{{ entry.icon }}"></i>
            {% endif %}
            <strong>{{ lang_name | strip }}:</strong>
            {{ fluency | strip }}
          </td>

          {% if column == 1 or forloop.last %}</tr>{% endif %}
        {% endfor %}
      </tbody>
    </table>
  </li>
</ul>
